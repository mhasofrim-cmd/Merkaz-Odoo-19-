<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_register_payment" model="ir.ui.view">
        <field name="name">res.partner.view.form.register.payment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_register_customer_payment"
                        class="oe_stat_button"
                        icon="fa-usd"
                        groups="account.group_account_invoice,account.group_account_readonly">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Register Payment</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
